{
  "manifest_version": 3,
  "name": "EnergyGuard Link Guard",
  "version": "1.0.0",
  "description": "Raises your guard on risky links when EnergyGuard sees you are tired. Talks only to the EnergyGuard app on 127.0.0.1.",
  "key": "",
  "host_permissions": ["http://127.0.0.1/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
